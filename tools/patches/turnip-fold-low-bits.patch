diff --git a/src/compiler/nir/nir_opt_algebraic.py b/src/compiler/nir/nir_opt_algebraic.py
index b82a73a..ba88406 100644
--- a/src/compiler/nir/nir_opt_algebraic.py
+++ b/src/compiler/nir/nir_opt_algebraic.py
@@ -694,8 +694,29 @@ for log2 in range(1, 7): # powers of two from 2 to 64
        (('iand', a_is_multiple, mask), a),
        # Reassociate for improved CSE
        (('iand', ('iadd', a_is_multiple, b), mask), ('iadd', ('iand', b, mask), a)),
+       # The low bits of a multiple plus something are the something's: (16 * i + 9) & 3 = 1. Translated shaders
+       # index uniform arrays of vec4 as [w >> 2][w & 3] with w a multiple of 4 plus a constant; folding the
+       # component makes it a constant before the access is lowered, one aligned load instead of a select chain.
+       (('iand', a_is_multiple, v - 1), 0),
+       (('iand', ('iadd', a_is_multiple, b), v - 1), ('iand', b, v - 1)),
    ])
 
+# The same through a shift, the word index of a byte offset: ((32 * i + 8) >> 2) & 3 = 2. Bits below the multiple's
+# own are the addend's alone (a carry only goes up).
+for s in [2, 4]:
+   for log2 in range(1, 3):
+      m = (1 << log2) - 1
+      v = 1 << (s + log2)
+      if v > 64:
+         continue
+      a_is_multiple = 'a(is_unsigned_multiple_of_{})'.format(v)
+      optimizations.extend([
+         (('iand', ('ushr', ('iadd', a_is_multiple, b), s), m), ('iand', ('ushr', b, s), m)),
+         (('iand', ('ishr', ('iadd', a_is_multiple, b), s), m), ('iand', ('ushr', b, s), m)),
+         (('iand', ('iadd', ('ushr', ('iadd', a_is_multiple, b), s), c), m), ('iand', ('iadd', ('ushr', b, s), c), m)),
+         (('iand', ('iadd', ('ishr', ('iadd', a_is_multiple, b), s), c), m), ('iand', ('iadd', ('ushr', b, s), c), m)),
+      ])
+
 # To save space in the state tables, reduce to the set that is known to help.
